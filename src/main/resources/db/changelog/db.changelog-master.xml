<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="1" author="system">
        <createTable tableName="analysis_reports">
            <column name="id" type="uuid" constraints="primaryKey:true"/>
            <column name="diagram_id" type="uuid"/>
            <column name="template_id" type="varchar(255)"/>
            <column name="components" type="jsonb"/>
            <column name="risks" type="jsonb"/>
            <column name="recommendations" type="jsonb"/>
            <column name="generated_at" type="timestamp"/>
            <column name="generated_by" type="varchar(255)"/>
            <column name="status" type="varchar(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="system">
        <addColumn tableName="analysis_reports">
            <column name="template_id" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
